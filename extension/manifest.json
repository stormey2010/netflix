{
  "manifest_version": 3,
  "name": "Netflix Connect",
  "version": "0.8.0",
  "description": "Watch together across Netflix, YouTube, Prime Video, Hulu, Peacock, and Disney+.",
  "key": "",
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "action": {
    "default_title": "Netflix Connect",
    "default_popup": "popup.html",
    "default_icon": "images/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "https://www.primevideo.com/*",
    "https://primevideo.com/*",
    "https://www.hulu.com/*",
    "https://hulu.com/*",
    "https://www.peacocktv.com/*",
    "https://peacocktv.com/*",
    "https://www.disneyplus.com/*",
    "https://disneyplus.com/*",
    "https://netflix-api.faredrop.xyz/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js",
        "page-ui.js",
        "setup.html"
      ],
      "matches": [
        "https://www.netflix.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://youtu.be/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*",
        "https://www.hulu.com/*",
        "https://hulu.com/*",
        "https://www.peacocktv.com/*",
        "https://peacocktv.com/*",
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://netflix-api.faredrop.xyz wss://netflix-api.faredrop.xyz"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://youtu.be/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*",
        "https://www.hulu.com/*",
        "https://hulu.com/*",
        "https://www.peacocktv.com/*",
        "https://peacocktv.com/*",
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*"
      ],
      "js": [
        "js/config.js",
        "js/providers.js",
        "js/utils.js",
        "js/user.js",
        "js/player.js",
        "js/stream.js",
        "js/telemetry.js",
        "js/sync.js",
        "js/navigation.js",
        "js/notifications.js",
        "js/share-button.js",
        "js/injector.js",
        "js/session.js",
        "js/messages.js",
        "js/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
